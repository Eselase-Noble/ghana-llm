  "weight_decay": 0.1,
  "grad_clip": 1.0,
  "warmup_steps": 300,
  "max_steps": 8000,

  "log_every": 50,
  "eval_every": 500,
  "eval_iters": 100,
  "cpu_threads": 8
}
